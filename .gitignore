node_modules/
out/
*.vsix
.data/
.snapshots/

# Branding and asset sources stay local. `public/` is the exception: it holds
# the exported images the README and the marketplace listing point at, so those
# have to be committed or the links resolve to nothing once published.
# Written as a wildcard rather than `.product/`, because git cannot re-include
# a path whose parent directory is excluded.
.product/*
!.product/public/
# Video never belongs in git: masters run to hundreds of MB and the marketplace
# strips <video> anyway, so nothing references them from the repo.
.product/public/**/*.mov
.product/public/**/*.mp4
.product/public/**/*.webm
.env
.env.*
!.env.example
.playwright-mcp/
CLAUDE.md
